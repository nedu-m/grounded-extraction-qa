# Optional: the live-model extractor. Everything else runs without credentials.
# Never commit this file. Copy it to .env and fill it in.
#
# The harness reads the first of these that is set:
#   DEEPSEEK_API_KEY, GEQ_LLM_API_KEY, OPENAI_API_KEY
DEEPSEEK_API_KEY=

# Any OpenAI-compatible chat-completions endpoint works.
GEQ_LLM_MODEL=deepseek-chat
GEQ_LLM_BASE_URL=https://api.deepseek.com

# Point the API at a different corpus if you are scoring your own documents.
# GEQ_CORPUS=data/golden
